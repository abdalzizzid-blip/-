{
  "expo": {
    "name": "KoraFlix",
    "slug": "koraflix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06020f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alwaseetpay.koraflix",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06020f"
      },
      "package": "com.alwaseetpay.koraflix",
      "userInterfaceStyle": "dark",
      "permissions": [
        "INTERNET",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "koraflix",
    "extra": {
      "eas": {
        "projectId": "b1241537-0b56-4f52-a4b9-ac0943cc89b9"
      }
    }
  }
}
