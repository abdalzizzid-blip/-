rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role Lookup function checking users collection state securely
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 3. User Entity Constraints & Validator Blueprint (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'role', 'watchlist', 'history']) &&
             data.keys().size() == 7 &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 1024 &&
             data.role is string && (data.role == 'user' || data.role == 'admin') &&
             data.watchlist is list && data.watchlist.size() <= 200 &&
             data.history is list && data.history.size() <= 200;
    }

    function isValidMediaRequest(data) {
      return data.keys().hasAll(['id', 'title', 'type', 'userId', 'createdAt', 'status']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.type is string && (data.type == 'movie' || data.type == 'tv') &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected');
    }

    // Match block for users collection targeting specific profile updates
    match /users/{userId} {
      
      // Ensure reading is private to the owner to satisfy PII constraints, or authenticated Admin users
      allow get: if isOwner(userId) || isAdmin();
      
      // Prevent query scraping by enforcing the ownerId check directly on listing attempts
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Create constraint: Must match the authenticated user, role defaults to 'user' for safety
      allow create: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidId(userId) && 
                    isValidUserProfile(incoming()) && 
                    incoming().role == 'user'; // Forbid self-assignment of Admin roles during sign-up

      // Update constraints: User can only affect specific keys; role/email remain immutable
      allow update: if isSignedIn() && 
                    isValidId(userId) && 
                    isValidUserProfile(incoming()) && 
                    (
                      // Action: Standard user updates watchlist, history, or profile aesthetics
                      (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'watchlist', 'history'])) ||
                      
                      // Escaped Action: System Administrator modifications
                      isAdmin()
                    );

      // Disable deletion of accounts by standard users directly from client-side SDK for state persistence
      allow delete: if isAdmin();
    }

    // Match block for requests collection
    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                    isValidId(requestId) &&
                    isValidMediaRequest(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'pending';
      allow update: if isSignedIn() && (
                    isAdmin() ||
                    (isOwner(existing().userId) && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['title', 'type', 'category', 'year', 'notes', 'userName', 'userEmail']) && 
                     isValidMediaRequest(incoming()))
                    );
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId));
    }
  }
}
